class Solution {
    public List<String> letterCasePermutation(String s) {
        if(s == null || s.length() == 0) return new ArrayList<>();
        List<String> result = new ArrayList<>();
        Helper(0, s.toCharArray(), result, new StringBuilder());
        return result;
    }

    //Helper Function
    public void Helper(int index, char[] s_char, List<String> result, StringBuilder sb){
        //base case
        if(sb.length() == s_char.length){
            result.add(sb.toString());
            return;
        }
        
        char ch = s_char[index];
        if(Character.isDigit(ch)){
            sb.append(ch);
            Helper(index + 1, s_char, result, sb);
            sb.deleteCharAt(sb.length() - 1);
        }
        else {
            sb.append(Character.toLowerCase(ch));
            Helper(index + 1, s_char, result, sb);
            sb.deleteCharAt(sb.length() - 1);

            sb.append(Character.toUpperCase(ch));
            Helper(index + 1, s_char, result, sb);
            sb.deleteCharAt(sb.length() - 1);
        }
    }
}
