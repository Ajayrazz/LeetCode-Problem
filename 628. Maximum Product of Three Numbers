class Solution {
    public int maximumProduct(int[] nums) {
        if(nums.length <= 2) return 0;
        Arrays.sort(nums);
        int max_val1 = nums[nums.length - 3] * nums[nums.length - 2] * nums[nums.length - 1];
        int max_val2 = nums[nums.length - 1] * nums[0] * nums[1];
        return Math.max(max_val1, max_val2);
    }
}
