class Solution {
    public boolean predictTheWinner(int[] nums) {
        int size = nums.length;
        if (size % 2 == 0) {
            return true;
        }
        Integer[][] memo = new Integer[size][size];
        return solve(nums, 0, size - 1, memo) >= 0;
    }

    private int solve(int[] nums, int left, int right, Integer[][] memo) {
        if (left == right) {
            return nums[left];
        }
        if (memo[left][right] != null) {
            return memo[left][right];
        }

        int chooseFront = nums[left] - solve(nums, left + 1, right, memo);
        int chooseBack = nums[right] - solve(nums, left, right - 1, memo);
        memo[left][right] = Math.max(chooseFront, chooseBack);
        return memo[left][right];
    }
}
