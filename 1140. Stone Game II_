class Solution {
    public int stoneGameII(int[] piles) {
        int n = piles.length;
        int[] suffixSum = new int[n + 1];
        for (int i = n - 1; i >= 0; i--) {
            suffixSum[i] = suffixSum[i + 1] + piles[i];
        }

        int[][] memo = new int[n][n + 1];
        return solve(0, 1, piles, suffixSum, memo, n);
    }

    private int solve(int index, int m, int[] piles, int[] suffixSum, int[][] memo, int n) {
        //base case
        if (index >= n) {
            return 0;
        }

        if (index + 2 * m >= n) {
            return suffixSum[index];
        }

        if (memo[index][m] != 0) {
            return memo[index][m];
        }

        int maxScore = 0;
        for (int take = 1; take <= 2 * m; take++) {
            int nextM = Math.max(m, take);
            int score = suffixSum[index] - solve(index + take, nextM, piles, suffixSum, memo, n);
            maxScore = Math.max(maxScore, score);
        }

        memo[index][m] = maxScore;
        return maxScore;
    }
}
