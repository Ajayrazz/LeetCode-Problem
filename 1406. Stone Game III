class Solution {
    public String stoneGameIII(int[] stoneValue) {
        int n = stoneValue.length;
        int[] dp = new int[n + 3];
        int totalSum = 0;

        for (int value : stoneValue) {
            totalSum += value;
        }

        int suffixSum = 0;

        for (int i = n - 1; i >= 0; i--) {
            suffixSum += stoneValue[i];

            int bestOpponent = Math.min(dp[i + 1], Math.min(dp[i + 2], dp[i + 3]));
            dp[i] = suffixSum - bestOpponent;
        }

        int alice = dp[0];
        int bob = totalSum - alice;

        if (alice > bob) {
            return "Alice";
        } else if (alice < bob) {
            return "Bob";
        }

        return "Tie";
    }
}
